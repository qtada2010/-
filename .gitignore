# الاعتماديات — تُثبَّت عبر npm install ولا تُرفع إلى المستودع
node_modules/

# متغيرات البيئة والأسرار (التوكن، كلمة مرور اللوحة، رابط قاعدة البيانات)
.env
.env.*
!.env.example

# سجلات ومخرجات التشغيل
*.log
npm-debug.log*
logs/

# ملفات أنظمة التشغيل والمحررات
.DS_Store
Thumbs.db
.vscode/
.idea/

# ملفات مؤقتة
tmp/
*.tmp

# لقطات التحقق من صفحات اللوحة (تُولَّد محلياً عبر npm run snapshot)
.snapshots/
