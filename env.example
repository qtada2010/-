# ==========================================================================
# نموذج متغيرات البيئة المطلوبة لتشغيل البوت
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا ترفع ملف .env إلى GitHub.
# ==========================================================================

# توكن بوت الديسكورد من https://discord.com/developers/applications
DISCORD_TOKEN=

# رابط اتصال قاعدة بيانات PostgreSQL
# مثال: postgresql://user:password@host:5432/dbname
#
# ⚠️ إن كنت تستخدم Supabase وظهر خطأ:
#    (EMAXCONNSESSION) max clients reached in session mode
#    فاستخدم رابط «Transaction pooler» على المنفذ 6543 بدل 5432:
#    postgresql://postgres.xxxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# الحد الأقصى لاتصالات قاعدة البيانات لكل نسخة من البوت (اختياري، الافتراضي 5)
# مجمّع الجلسات في Supabase يحدّ الاتصالات (15 افتراضياً)، فإن شغّلت أكثر من
# نسخة قلّل الرقم: نسختان × 5 = 10 اتصالات (آمن)، ونسختان × 10 الافتراضي = 20

PG_POOL_MAX=5

# كلمة مرور الدخول إلى لوحة التحكم.
# ⚠️ مهم: إذا تُرك فارغاً يتعطّل تسجيل الدخول للوحة بالكامل (إجراء أمني مقصود).
# استخدم كلمة مرور طويلة وعشوائية؛ منها تُشتق جلسة اللوحة وتوكن حماية CSRF.
DASHBOARD_PASSWORD=

# منفذ خادم لوحة التحكم (اختياري، الافتراضي 3000)
PORT=3000

# الرابط العام للوحة التحكم (اختياري) — يُستخدم في أزرار وروابط البوت
# إذا تُرك فارغاً يُستخدم RENDER_EXTERNAL_URL ثم الموقع الرسمي
DASHBOARD_URL=
